# Local development: a SQLite file relative to the project root.
DATABASE_URL="file:./dev.db"

# Production (Turso / hosted libSQL). Vercel's filesystem is ephemeral, so a
# file: URL there loses every write. Set these in the Vercel dashboard instead:
# DATABASE_URL="libsql://your-db.turso.io"
# DATABASE_AUTH_TOKEN="your-token"
