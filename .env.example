# Prisma Postgres connection string.
#
# From console.prisma.io -> your database -> Connection strings. Take the direct
# PostgreSQL/TCP string, NOT the prisma+postgres://...?api_key=... one:
# @prisma/adapter-pg wraps node-postgres, which cannot parse that protocol.
#
# Use sslmode=verify-full rather than require. node-postgres treats `require` as
# verify-full today, but pg v9 will switch it to libpq semantics (encrypted but
# unverified). Being explicit keeps certificate verification after that change.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=verify-full"

# For local development with no cloud account, run:
#   npx prisma dev --detach --name winter-arc
# and use the TCP URL it prints, e.g.
# DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# ---- auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotating this signs every user out.
BETTER_AUTH_SECRET=""

# The origin verification and password-reset links point at.
# Locally http://localhost:3000; in production your real https:// URL.
BETTER_AUTH_URL="http://localhost:3000"

# ---- email ----
# Verification and password-reset delivery, via Resend.
# If unset, links are logged to the SERVER CONSOLE instead of being emailed.
# That is fine for testing alone, but nobody else can verify their account
# until a real key and a verified sending domain are configured.
RESEND_API_KEY=""
EMAIL_FROM="Winter Arc <noreply@yourdomain.com>"
