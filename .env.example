# Prisma Postgres connection string.
#
# Get it from https://console.prisma.io -> your project -> Connect, or by
# running `npx prisma postgres link`. Direct TCP needs sslmode=require.
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# In production (Vercel), prefer the POOLED endpoint instead, so concurrent
# serverless invocations share connections rather than exhausting them:
# DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
